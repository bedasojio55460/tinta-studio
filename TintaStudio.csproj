<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TintaStudio</AssemblyName>
    <RootNamespace>TintaStudio</RootNamespace>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Proyek tes tidak ikut terkompilasi ke aplikasi -->
  <ItemGroup>
    <Compile Remove="TintaStudio.Tests\**" />
    <AvaloniaResource Remove="TintaStudio.Tests\**" />
    <Content Remove="TintaStudio.Tests\**" />
    <None Remove="TintaStudio.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- Dekoder TIFF terkelola: build libSkiaSharp 3.119.4 tidak membawa codec TIFF -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <!-- PDFtoImage 5.2.0: versi terakhir yang sejalan SkiaSharp 3.119.x (Avalonia 12);
         5.3+ menuntut SkiaSharp 4.x yang bertabrakan dengan Avalonia 12.0.5. -->
    <PackageReference Include="PDFtoImage" Version="5.2.0" />
    <!-- Runtime ONNX (CPU) untuk deteksi teks + OCR PaddleOCR (Tahap 2) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TintaStudio.Tests" />
  </ItemGroup>

</Project>
