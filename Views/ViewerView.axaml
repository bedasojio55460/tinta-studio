<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TintaStudio.ViewModels"
             x:Class="TintaStudio.Views.ViewerView"
             x:DataType="vm:MainWindowViewModel">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="{Binding ChapterTitle}"
                   FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="◀ Sebelumnya" Command="{Binding PrevPageCommand}" />
            <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" FontSize="13" />
            <Button Content="Berikutnya ▶" Command="{Binding NextPageCommand}" />
        </StackPanel>
        <Grid ColumnDefinitions="186,*" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedIndex="{Binding SelectedPageIndex}"
                     Background="#0D1622">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItemViewModel">
                        <StackPanel Spacing="3" HorizontalAlignment="Center" Margin="4">
                            <Image Source="{Binding Thumbnail}" Width="142" Stretch="Uniform" />
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{Binding Detail}" HorizontalAlignment="Center"
                                       FontSize="10" Foreground="#8FA3B8" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Background="#0B1220" Margin="12,0,0,0" CornerRadius="6">
                <Image Source="{Binding CurrentPageBitmap}" Stretch="Uniform" Margin="10" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
