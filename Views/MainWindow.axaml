<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TintaStudio.ViewModels"
        xmlns:views="using:TintaStudio.Views"
        x:Class="TintaStudio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Tinta Studio"
        Width="1400" Height="860"
        MinWidth="1000" MinHeight="640"
        Icon="avares://TintaStudio/Assets/logo.png">
    <DockPanel>
        <!-- Bar status bawah ramping: versi + status kiri, konteks kanan -->
        <Border DockPanel.Dock="Bottom" Background="#101216"
                BorderBrush="#26292F" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="v0.7.13 — Typeset Otomatis" Foreground="#8A939E" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="18,0,12,0"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding ContextInfo}" Foreground="#8A939E"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="216,*">
            <!-- Sidebar -->
            <Border Background="#101216" BorderBrush="#26292F" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Spacing="5">
                        <Image Source="avares://TintaStudio/Assets/logo.png"
                               Width="52" Height="52" HorizontalAlignment="Left" />
                        <TextBlock Text="Tinta Studio" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Penerjemah &amp; penyunting komik"
                                   Foreground="#8A939E" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2" Margin="0,20,0,0">
                        <Button x:Name="MenuLibrary" Classes="menu" Content="Pustaka" />
                        <Button x:Name="MenuViewer" Classes="menu" Content="Penampil" />
                        <Button x:Name="MenuDetect" Classes="menu" Content="Deteksi &amp; OCR" />
                        <Button x:Name="MenuClean" Classes="menu" Content="Bersihkan" />
                        <Button x:Name="MenuTranslate" Classes="menu" Content="Terjemahan" />
                        <Button x:Name="MenuTypeset" Classes="menu" Content="Typesetting" />
                        <Button x:Name="MenuExport" Classes="menu" Content="Ekspor" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Konten -->
            <Grid Grid.Column="1" Background="#14171C">
                <views:LibraryView IsVisible="{Binding IsLibraryActive}" />
                <views:ViewerView IsVisible="{Binding IsViewerActive}" />
                <views:DetectView IsVisible="{Binding IsDetectActive}" />
                <views:CleanView IsVisible="{Binding IsCleanActive}" />
                <views:TranslateView IsVisible="{Binding IsTranslateActive}" />
                <views:TypesetView IsVisible="{Binding IsTypesetActive}" />
                <views:ExportView IsVisible="{Binding IsExportActive}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
